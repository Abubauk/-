{
  "_help": "Формулы: w,h — ширина и высота окна в метрах; n — число секций; s — число открывающихся створок; sw,sh — размеры створки (м); gw,gh — размеры стеклопакета одной секции (м); P — периметр окна (м). pcs — формула количества штук (нарезанных деталей), qty — формула общей длины (м) или площади (м²). Для unit 'шт' qty не нужен.",
  "parts": [
    { "id": "frame",    "name": "Рамный профиль",        "unit": "м",  "pcs": "4",                 "qty": "2*(w+h)" },
    { "id": "impost",   "name": "Импост",                "unit": "м",  "pcs": "n-1",               "qty": "(n-1)*(h-0.12)" },
    { "id": "sash",     "name": "Створочный профиль",    "unit": "м",  "pcs": "4*s",               "qty": "s*2*(sw+sh)" },
    { "id": "bead",     "name": "Штапик",                "unit": "м",  "pcs": "4*n",               "qty": "n*2*(gw+gh)" },
    { "id": "steel",    "name": "Армирование (сталь)",   "unit": "м",  "pcs": "4+(n-1)+4*s",       "qty": "2*(w+h)+(n-1)*(h-0.12)+s*2*(sw+sh)" },
    { "id": "gasket",   "name": "Уплотнитель",           "unit": "м",  "pcs": "1",                 "qty": "P+s*2*(sw+sh)+n*2*(gw+gh)" },
    { "id": "glass",    "name": "Стеклопакет",           "unit": "м²", "pcs": "n",                 "qty": "n*gw*gh" },
    { "id": "fittings", "name": "Фурнитура (комплект)",  "unit": "шт", "pcs": "s" },
    { "id": "handle",   "name": "Ручка",                 "unit": "шт", "pcs": "s" },
    { "id": "sill",     "name": "Подоконник",            "unit": "м",  "pcs": "1",                 "qty": "w+0.1" },
    { "id": "ebb",      "name": "Отлив",                 "unit": "м",  "pcs": "1",                 "qty": "w+0.06" }
